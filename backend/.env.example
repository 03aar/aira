# AIRA Backend Environment Variables

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# GitHub API (Optional - for private repos)
GITHUB_TOKEN=ghp_your-github-token-here

# Database Configuration
DATABASE_URL=sqlite:///./aira.db  # SQLite for development
# DATABASE_URL=postgresql://user:password@localhost:5432/aira  # PostgreSQL for production
REDIS_URL=redis://localhost:6379

# Database Connection Pool (PostgreSQL only)
DB_POOL_SIZE=20           # Number of permanent connections in the pool
DB_MAX_OVERFLOW=40        # Additional connections when pool is full
DB_POOL_TIMEOUT=30        # Seconds to wait for a connection
DB_POOL_RECYCLE=3600      # Recycle connections after 1 hour

# Environment
ENV=development           # development or production

# Backup Configuration
BACKUP_DIR=./backups      # Directory for database backups

# Authentication & Security
SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32
FRONTEND_URL=http://localhost:5173

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@aira.app

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API Rate Limiting
RATE_LIMIT=100  # requests per minute
